# AI Studio Environment Variables Example
# GEMINI_API_KEY is provided automatically by AI Studio if MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API is present.
GEMINI_API_KEY=

# Configuration de l'envoi d'emails réels (Code de vérification Wavegram)
# Option A : Gmail avec mot de passe d'application (Recommandé pour Gmail)
# Activez la validation en 2 étapes sur Google, puis créez un mot de passe d'application sur myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Option B : Serveur SMTP personnalisé (Brevo, Mailjet, SendGrid, Mailgun, OVH...)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Wavegram Sécurité" <no-reply@votre-domaine.com>

# Option C : Clé API Resend
# RESEND_API_KEY=
